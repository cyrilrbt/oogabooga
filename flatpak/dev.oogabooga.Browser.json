{
  "app-id": "dev.oogabooga.Browser",
  "runtime": "org.gnome.Platform",
  "runtime-version": "50",
  "sdk": "org.gnome.Sdk",
  "command": "oogabooga",
  "finish-args": [
    "--share=network",
    "--share=ipc",
    "--socket=wayland",
    "--socket=fallback-x11",
    "--socket=pulseaudio",
    "--device=dri"
  ],
  "modules": [
    {
      "name": "oogabooga",
      "buildsystem": "simple",
      "build-commands": [
        "./build.sh test",
        "./build.sh release",
        "install -Dm755 build/linux/oogabooga /app/bin/oogabooga",
        "install -Dm644 VERSION /app/share/oogabooga/VERSION",
        "install -Dm644 LICENSE /app/share/licenses/oogabooga/LICENSE",
        "install -Dm644 CHANGELOG.md /app/share/doc/oogabooga/CHANGELOG.md",
        "install -Dm644 assets/oogabooga.desktop /app/share/applications/dev.oogabooga.Browser.desktop",
        "install -Dm644 assets/oogabooga-512.png /app/share/icons/hicolor/512x512/apps/dev.oogabooga.Browser.png",
        "install -Dm644 build/metadata/dev.oogabooga.Browser.metainfo.xml /app/share/metainfo/dev.oogabooga.Browser.metainfo.xml"
      ],
      "sources": [
        {
          "type": "dir",
          "path": "..",
          "skip": [
            ".git",
            "build",
            ".flatpak-builder",
            "flatpak-build",
            "flatpak-repo"
          ]
        }
      ]
    }
  ]
}
